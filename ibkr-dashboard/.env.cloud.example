# ── Combined app (set as Fly.io secrets on: ibkr-dashboard) ───────────────────
TWS_USERID=your_ibkr_username
TWS_PASSWORD=your_ibkr_password
IB_ACCOUNT_ID=DU1234567
IB_CLIENT_ID=17
TRADING_MODE=paper

DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.us-east-2.aws.neon.tech/ibkr_dashboard?sslmode=require

CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-app.clerk.accounts.dev
CLERK_AUDIENCE=ibkr-dashboard
CLERK_SECRET_KEY=sk_test_xxx

ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-opus-4-5

# Your Vercel frontend URL
CORS_ORIGINS=https://ibkr-dashboard.vercel.app

# ── Frontend (set as Vercel environment variables) ────────────────────────────
VITE_API_URL=https://ibkr-dashboard.fly.dev/api/v1
VITE_WS_URL=wss://ibkr-dashboard.fly.dev
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
VITE_ENABLE_COPILOT=true
